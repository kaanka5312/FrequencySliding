library(R.matlab)
# Read files
BP <- readMat("./data/output/PF_BP.mat")
HC <- readMat("./data/output/PF_HC.mat")
n_bp <- 38
n_hc <- 33
# Define all component names
components <- c("PF.peak", "PF.trough", "PF.rise", "PF.fall", "PF.whole")
# Initialize result list
PF_all_scaled <- list()
for (comp in components) {
# Extract component from each subject (1st dimension is subject, 2nd is region)
PF_bp_mat <- t(sapply(BP$PF.all.slow5[1:n_bp], function(x) {
x[[1]][comp, 1, 1][[1]]
}))
PF_hc_mat <- t(sapply(HC$PF.all.slow5[1:n_hc], function(x) {
x[[1]][comp, 1, 1][[1]]
}))
# Combine and scale
PF_all_scaled[[comp]] <- scale(rbind(PF_bp_mat, PF_hc_mat))
}
PF_all_scaled[[1]]
PF_all_scaled$PF.peak
# Initialize list to hold long data
long_list <- list()
# Loop over each PF component and reshape
for (comp in names(PF_all_scaled)) {
df <- as.data.frame(PF_all_scaled[[comp]])
colnames(df) <- region_names
df$subj_id <- 1:71
df$group <- rep(c("BP", "HC"), times = c(38, 33))
df_long <- pivot_longer(df, cols = all_of(region_names),
names_to = "region", values_to = "value")
df_long$component <- comp
long_list[[comp]] <- df_long
}
region_names <- paste0("V", 1:360)
# Initialize list to hold long data
long_list <- list()
# Loop over each PF component and reshape
for (comp in names(PF_all_scaled)) {
df <- as.data.frame(PF_all_scaled[[comp]])
colnames(df) <- region_names
df$subj_id <- 1:71
df$group <- rep(c("BP", "HC"), times = c(38, 33))
df_long <- pivot_longer(df, cols = all_of(region_names),
names_to = "region", values_to = "value")
df_long$component <- comp
long_list[[comp]] <- df_long
}
# Combine all components
all_pf_long <- bind_rows(long_list)
all_pf_long
all_pf_long[[1]]
# Initialize the result list
PF_long_list <- list()
# Loop over each PF component
for (comp in names(PF_all_scaled)) {
df <- as.data.frame(PF_all_scaled[[comp]])
colnames(df) <- region_names
df$subj_id <- 1:71
df$group <- rep(c("BP", "HC"), times = c(38, 33))
# Convert to long format
df_long <- pivot_longer(df, cols = all_of(region_names),
names_to = "region", values_to = "value")
# Add region_type
df_long <- left_join(df_long, region_types, by = "region")
# Save in the list
PF_long_list[[comp]] <- df_long
}
PF_long_list
# Initialize the result list
PF_long_list <- list()
# Loop over each PF component
for (comp in names(PF_all_scaled)) {
df <- as.data.frame(PF_all_scaled[[comp]])
colnames(df) <- region_names
df$subj_id <- 1:71
df$group <- rep(c("BP", "HC"), times = c(38, 33))
# Convert to long format
df_long <- pivot_longer(df, cols = all_of(region_names),
names_to = "region", values_to = "value")
# Add region_type
df_long <- left_join(df_long, region_types, by = "region")
# Save in the list
PF_long_list[[comp]] <- df_long
}
PF_long_list
library(brms)
# Initialize empty list to hold model fits
fit_list <- list()
# Loop through each component's long data frame
for (comp in names(PF_long_list)) {
message("Fitting model for: ", comp)
fit_list[[comp]] <- brm(
value ~ group * region_type + (1 | subj_id) + (1 | region),
data = PF_long_list[[comp]],
family = gaussian(),
chains = 4,
iter = 2000,
cores = 6,
seed = 123  # Set seed for reproducibility
)
}
saveRDS(fit_list, file = "./data/output/PF_brms_models.rds")
plot(conditional_effects(fit_list[[1]], effects = "region_type:group"))
summary(fit_list[[1]])
plot(conditional_effects(fit_list[[2]], effects = "region_type:group"))
plot(conditional_effects(fit_list[[3]], effects = "region_type:group"))
plot(conditional_effects(fit_list[[4]], effects = "region_type:group"))
plot(conditional_effects(fit_list[[5]], effects = "region_type:group"))
plot(conditional_effects(fit_list[[4]], effects = "region_type:group"))
summary(fit_list[[4]])
names(PF_long_list)
plot(conditional_effects(fit_list[[1]], effects = "region_type:group"),title=names(PF_long_list)[1])
help(conditional_effects)
