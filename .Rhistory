draws_slopes <- posterior::draws_of(do.call(cbind, as.list(slopes)))
subject_ids <- colnames(intercepts)
subject_groups <- PF_collapsed_list[[comp]] %>%
distinct(subj_id, group) %>%
mutate(subj_id = as.character(subj_id)) %>%
filter(subj_id %in% subject_ids) %>%
arrange(match(subj_id, subject_ids)) %>%
pull(group)
n_draws <- nrow(draws_intercepts)
cor_bp <- numeric(n_draws)
cor_hc <- numeric(n_draws)
for (i in 1:n_draws) {
intercepts_bp <- draws_intercepts[i, subject_groups == "BP"]
slopes_bp <- draws_slopes[i, subject_groups == "BP"]
intercepts_hc <- draws_intercepts[i, subject_groups == "HC"]
slopes_hc <- draws_slopes[i, subject_groups == "HC"]
cor_bp[i] <- cor(intercepts_bp, slopes_bp)
cor_hc[i] <- cor(intercepts_hc, slopes_hc)
}
draws_intercepts <- array(draws_intercepts, dim = c(nrow(draws_intercepts), dim(draws_intercepts)[3]))
draws_slopes <- array(draws_slopes, dim = c(nrow(draws_slopes), dim(draws_slopes)[3]))
for (i in 1:n_draws) {
intercepts_bp <- draws_intercepts[i, subject_groups == "BP"]
slopes_bp <- draws_slopes[i, subject_groups == "BP"]
intercepts_hc <- draws_intercepts[i, subject_groups == "HC"]
slopes_hc <- draws_slopes[i, subject_groups == "HC"]
cor_bp[i] <- cor(intercepts_bp, slopes_bp)
cor_hc[i] <- cor(intercepts_hc, slopes_hc)
}
flatten_draws <- function(x) {
array(x, dim = c(dim(x)[1], dim(x)[3]))
}
draws_intercepts <- flatten_draws(draws_intercepts)
