help("pp_check")
head(PF_collapsed_list[[5]])
fit <- test
fit <- fit_list[[5]]
library(dplyr)
library(bayesplot)
# Step 1: Get posterior predictive samples
y_rep <- posterior_predict(fit)  # Matrix: iterations × observations
# Step 2: Get the subject ID vector (must match row order of model input data)
subj_ids <- PF_collapsed_list[[comp]]$subj_id
# Step 3: Aggregate to subject-level means
# First, observed subject-level means
obs_means <- PF_collapsed_list[[comp]] %>%
group_by(subj_id) %>%
summarize(obs = mean(value)) %>%
pull(obs)
# Then aggregate each posterior sample (row of y_rep) to subject-level
# This gives a matrix: iterations × subjects
library(matrixStats)
subject_index <- split(seq_along(subj_ids), subj_ids)
y_rep_subject <- sapply(subject_index, function(rows) {
rowMeans(y_rep[, rows, drop = FALSE])
})
# Step 4: Posterior predictive check at subject level
ppc_dens_overlay(y = obs_means, yrep = y_rep_subject[1:100, ])
library(brms)
library(dplyr)
library(bayesplot)
# Extract posterior predictive draws
y_rep <- posterior_predict(fit)
# Match to data
data <- PF_collapsed_list[[comp]]
data$y <- data$value  # original outcome
# Loop over subjects
unique_subjects <- unique(data$subj_id)
for (subj in unique_subjects) {
message("Plotting subject: ", subj)
# Filter data for this subject
subj_data <- data %>% filter(subj_id == subj)
subj_yrep <- y_rep[, data$subj_id == subj]
# Separate unimodal and transmodal
for (cat in c("unimodal", "transmodal")) {
cat_data <- subj_data %>% filter(region_category == cat)
cat_yrep <- subj_yrep[, subj_data$region_category == cat]
if (nrow(cat_data) > 0) {
# Plot PPC overlay
p <- ppc_dens_overlay(cat_data$y, cat_yrep[1:100, ]) +
ggtitle(paste0("Subject ", subj, " - ", cat))
print(p)
}
}
}
