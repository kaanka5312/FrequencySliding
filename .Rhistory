packageVersion("posterior")
# Extract posterior draws manually:
draws_trans_bp <- draws_of(trans_bp)
draws_unimodal_bp <- draws_of(unimodal_bp)
draws_trans_hc <- draws_of(trans_hc)
draws_unimodal_hc <- draws_of(unimodal_hc)
# Compute correlations across posterior draws:
n_draws <- nrow(draws_trans_bp)
correlations_bp <- numeric(n_draws)
draws_bp <- posterior::as_draws_matrix(cbind(trans_bp, unimodal_bp))
trans_bp <- subject_transmodal[1, subject_groups == "BP"] %>% as.list()
unimodal_bp <- subject_unimodal[1, subject_groups == "BP"] %>% as.list()
trans_hc <- subject_transmodal[1, subject_groups == "HC"] %>% as.list()
unimodal_hc <- subject_unimodal[1, subject_groups == "HC"] %>% as.list()
# Combine posterior draws for BP subjects:
draws_trans_bp <- posterior::draws_of(do.call(cbind, trans_bp))
draws_unimodal_bp <- posterior::draws_of(do.call(cbind, unimodal_bp))
# Combine posterior draws for HC subjects:
draws_trans_hc <- posterior::draws_of(do.call(cbind, trans_hc))
draws_unimodal_hc <- posterior::draws_of(do.call(cbind, unimodal_hc))
n_draws <- nrow(draws_trans_bp)
correlations_bp <- numeric(n_draws)
correlations_hc <- numeric(n_draws)
for (i in 1:n_draws) {
correlations_bp[i] <- cor(draws_trans_bp[i, ], draws_unimodal_bp[i, ])
correlations_hc[i] <- cor(draws_trans_hc[i, ], draws_unimodal_hc[i, ])
}
dim(draws_trans_bp)
dim(draws_unimodal_bp)
dim(draws_trans_bp)
dim(draws_unimodal_bp)
n_draws <- nrow(draws_trans_bp)
correlations_bp <- numeric(n_draws)
correlations_hc <- numeric(n_draws)
for (i in 1:n_draws) {
correlations_bp[i] <- cor(draws_trans_bp[i, ], draws_unimodal_bp[i, ])
correlations_hc[i] <- cor(draws_trans_hc[i, ], draws_unimodal_hc[i, ])
}
# Reshape arrays
draws_trans_bp <- array(draws_trans_bp, dim = c(n_draws, dim(draws_trans_bp)[3]))
draws_unimodal_bp <- array(draws_unimodal_bp, dim = c(n_draws, dim(draws_unimodal_bp)[3]))
draws_trans_hc <- array(draws_trans_hc, dim = c(n_draws, dim(draws_trans_hc)[3]))
draws_unimodal_hc <- array(draws_unimodal_hc, dim = c(n_draws, dim(draws_unimodal_hc)[3]))
# Loop works normally now:
for (i in 1:n_draws) {
correlations_bp[i] <- cor(draws_trans_bp[i, ], draws_unimodal_bp[i, ])
correlations_hc[i] <- cor(draws_trans_hc[i, ], draws_unimodal_hc[i, ])
}
# Posterior mean and 95% credible interval for BP
mean(correlations_bp)
quantile(correlations_bp, c(0.025, 0.975))
# Posterior mean and 95% credible interval for HC
mean(correlations_hc)
quantile(correlations_hc, c(0.025, 0.975))
diff_cor <- correlations_bp - correlations_hc
# Summarize difference
mean(diff_cor)
quantile(diff_cor, c(0.025, 0.975))
