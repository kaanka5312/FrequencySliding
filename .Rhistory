priors <- c(
prior(normal(0, 0.5),            class = "Intercept"),          # mean intercept
prior(normal(0, 1.0),            class = "b")
)
fit_grp <- brm(
formula = f_BDI,
data    = dat,
family  = student(),          # enables σ & ν sub-models
prior   = priors,
chains  = 4, iter = 4000, cores = 4,
seed    = 123
)
fit_grp
pp_check(fit_grp, type = "error_scatter_avg")
bayes_R2(fit_grp)
f_BDI <- bf(
BDI_z ~ unimodal_z + transmodal_z  + sex + age_z,
sigma ~ unimodal_z + transmodal_z
)
priors <- c(
prior(normal(0, 0.5),            class = "Intercept"),          # mean intercept
prior(normal(0, 1.0),            class = "b")
)
fit_grp <- brm(
formula = f_BDI,
data    = dat,
family  = student(),          # enables σ & ν sub-models
prior   = priors,
chains  = 4, iter = 4000, cores = 4,
seed    = 123
)
fit_grp
pp_check(fit_grp, type = "error_scatter_avg")
cor(dat$BDI_z, dat$unimodal_z)
dat$BDI_z
cor(dat$BDI_z, dat$unimodal_z, use="comlete.obs")
cor(dat$BDI_z, dat$unimodal_z, use="complete.obs")
cor(dat$BDI_z, dat$transmodal_z, use="complete.obs")
