# Loop over all PF components in your PF_long_list
PF_collapsed_list <- lapply(PF_long_list, function(df) {
df %>%
mutate(region_category = case_when(
region_type %in% c("uni_self", "uni_nonself") ~ "unimodal",
region_type %in% c("trans_self", "trans_nonself") ~ "transmodal",
TRUE ~ NA_character_  # catch unexpected cases
)) %>%
group_by(subj_id, group, region_category) %>%
summarise(mean_value = mean(value, na.rm = TRUE), .groups = "drop")
})
